
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'Java'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Obteniendo codigo de GitHub...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Compilando proyecto...'
                bat 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo 'Ejecutando pruebas unitarias...'
                bat 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo 'Generando archivo JAR...'
                bat 'mvn package -DskipTests'
            }
        }
    }
}
